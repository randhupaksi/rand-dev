# Semua override di bawah opsional. Salin file ini menjadi `.env` lalu isi
# hanya dengan data publik yang memang ingin ditampilkan pada portfolio.
# Variabel berawalan VITE_ akan ikut dibundle ke kode browser; jangan taruh secret.

# Contact (dipakai di halaman Contact & footer)
VITE_EMAIL=

# CV (default mengarah ke PDF lokal di public/files/)
VITE_CV_URL=/files/Randhu_Paksi_Membumi_Frontend_Developer_CV.pdf

# Social Links (URL profil asli; LinkedIn publik sudah menjadi fallback di aplikasi)
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_DRIBBBLE=
